{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AI包工头",
  "version": "0.6.0-beta.8",
  "identifier": "com.huyan.ai-baogongtou",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI包工头",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNzNGQTM4Qjc0OEI1RUEKUldUcXRVaTNPUHB6cmg2NVJMRGl0TFZQaWNwZkpuYVQxdzU1WmltdWZPcFdXc1lwcmk4ZFRFUzYK",
      "endpoints": [
        "https://github.com/hyt24v/huyan_ai_contractor/releases/download/updater/latest.json"
      ]
    }
  }
}
