{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.claude.json"
        },
        {
          "path": "$HOME/.claude.json.*"
        },
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.ai-baogongtou"
        },
        {
          "path": "$HOME/.ai-baogongtou/**"
        },
        {
          "path": "$HOME/.codex/**"
        },
        {
          "path": "$HOME/.pi/**"
        },
        {
          "path": "$HOME/.cursor/**"
        },
        {
          "path": "$HOME/.gemini/**"
        },
        {
          "path": "$HOME/ai-skills/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/.claude.json"
        },
        {
          "path": "$HOME/.claude.json.*"
        },
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.ai-baogongtou"
        },
        {
          "path": "$HOME/.ai-baogongtou/**"
        },
        {
          "path": "$HOME/.codex/**"
        },
        {
          "path": "$HOME/.pi/**"
        },
        {
          "path": "$HOME/.cursor/**"
        },
        {
          "path": "$HOME/.gemini/**"
        },
        {
          "path": "$HOME/ai-skills/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.ai-baogongtou/**"
        },
        {
          "path": "$HOME/.codex/**"
        },
        {
          "path": "$HOME/.pi/**"
        },
        {
          "path": "$HOME/.cursor/**"
        },
        {
          "path": "$HOME/.gemini/**"
        },
        {
          "path": "$HOME/ai-skills/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.claude.json"
        },
        {
          "path": "$HOME/.claude.json.*"
        },
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.ai-baogongtou"
        },
        {
          "path": "$HOME/.ai-baogongtou/**"
        },
        {
          "path": "$HOME/.codex/**"
        },
        {
          "path": "$HOME/.pi/**"
        },
        {
          "path": "$HOME/.cursor/**"
        },
        {
          "path": "$HOME/.gemini/**"
        },
        {
          "path": "$HOME/ai-skills/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.ai-baogongtou/**"
        },
        {
          "path": "$HOME/.codex/**"
        },
        {
          "path": "$HOME/.pi/**"
        },
        {
          "path": "$HOME/.cursor/**"
        },
        {
          "path": "$HOME/.gemini/**"
        },
        {
          "path": "$HOME/ai-skills/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.ai-baogongtou/**"
        },
        {
          "path": "$HOME/.codex/**"
        },
        {
          "path": "$HOME/.pi/**"
        },
        {
          "path": "$HOME/.cursor/**"
        },
        {
          "path": "$HOME/.gemini/**"
        },
        {
          "path": "$HOME/ai-skills/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.ai-baogongtou/**"
        },
        {
          "path": "$HOME/.codex/**"
        },
        {
          "path": "$HOME/.pi/**"
        },
        {
          "path": "$HOME/.cursor/**"
        },
        {
          "path": "$HOME/.gemini/**"
        },
        {
          "path": "$HOME/ai-skills/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.ai-baogongtou/**"
        },
        {
          "path": "$HOME/.codex/**"
        },
        {
          "path": "$HOME/.pi/**"
        },
        {
          "path": "$HOME/.cursor/**"
        },
        {
          "path": "$HOME/.gemini/**"
        },
        {
          "path": "$HOME/ai-skills/**"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/ai-skills"
        },
        {
          "path": "$HOME/ai-skills/**"
        },
        {
          "path": "$HOME/.ai-baogongtou"
        },
        {
          "path": "$HOME/.ai-baogongtou/**"
        }
      ]
    }
  ]
}
